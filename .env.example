NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
# Public origin used in event emails (independent of local login).
PUBLIC_APP_URL=https://archivio-segreteria.segidio.org
# Postmark HTTP API (server Segreteria Segidio). No Gmail SMTP fallback.
POSTMARK_SERVER_TOKEN=
POSTMARK_TRANSACTIONAL_STREAM=outbound
POSTMARK_BROADCAST_STREAM=broadcast
EMAIL_FROM=segreteriagenerale@santegidio.org
EMAIL_REPLY_TO=segreteriagenerale@santegidio.org
# Archive event communications only (never login tokens) via Gmail IMAP APPEND.
EMAIL_SENT_ARCHIVE_ENABLED=false
GMAIL_USER=segreteriagenerale@santegidio.org
GMAIL_APP_PASSWORD=
# Independent random secrets, at least 32 characters; server-side only.
POSTMARK_WEBHOOK_SECRET=
EMAIL_ARCHIVE_CRON_SECRET=
